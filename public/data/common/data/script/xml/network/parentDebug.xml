<!-- root node must be called parent for scripts to recognise it -->
<parent>

	<!-- 
	#######################################################
	Menu Settings
	#######################################################
	-->

    <settings>
		<title string="General Debug" />
		<colour r="0" g="0" b="0" a="200" />
