<!-- 	
	This is the file we use to specify which files to search through when generating the playthrough mission list.					
	The node and attribute names are specifically for the playthrough_builder.sc script, not the debug menu. 						
		menuFile:  		This will be the playthrough order menu that lists the playthrough pages we generate.						
		pageFile:  		The mission pages that we generate - The playthrough builder will replace XXX with the actual page number.	
		orederFile:  	The file that stores the order of missions by file name. This is the file that is generated using the mid-flow launcher tool.
		file0-file22: 	The files that we grab the missions from.																	
		listSize:	 	The amount of missions we can have in each playthrough page.												
-->		

<?xml version='1.0'?>
<DebugMenuItems>
	<listItem	listSize="12"
				
				menuFile="SPPlaythrough/SP_playthroughCLF.xml"
				pageFile="SPPlaythrough/SP_playthroughCLF_XXX.xml"
				orderFile="SPPlaythrough/SP_playthroughCLF_order.xml"
				
				file0="SPDebug/SP_AGT_T.xml" 		
				file1="SPDebug/SP_AGT_CIA.xml" 		
				file2="SPDebug/SP_AGT_Russian.xml" 
				file3="SPDebug/SP_AGT_Paperman.xml"
				file4="SPDebug/SP_AGT_KOREAN.xml" 
				file5="SPDebug/SP_AGT_ARAB.xml" 		
				file6="SPDebug/SP_AGT_casino.xml" 
				file7="SPDebug/SP_AGT_Agent14.xml"
				file8="SPDebug/SP_AGT_RC1.xml"		
				file9="SPDebug/SP_AGT_Miles.xml"
				file10="SPDebug/SP_AGT_JET.xml"
				file11="SPDebug/SP_AGT_Assassin.xml"	/>
</DebugMenuItems>
