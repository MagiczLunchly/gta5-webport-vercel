<?xml version="1.0" encoding="UTF-8"?>

<GameRecorder__FilterInfo>
  <Filters>
    <Item>PedCapsuleInfoEvent</Item>
    <Item>PedDataEvent</Item>
    <Item>VehicleDataEvent</Item>
    <Item>DRNetBlenderStateEvent</Item>
    <Item>CameraEvent</Item>
    <Item>CStoreTasks</Item>
    <Item>StoreSkeletonPostUpdate</Item>
    <Item>CTaskFlowDebugEvent</Item>
  </Filters>
  <bRecordSkeletonsEveryFrame value="true" />
  <bPosePedsIfPossible value="true" />
  <bUseLowLodSkeletons value="true" />
</GameRecorder__FilterInfo>