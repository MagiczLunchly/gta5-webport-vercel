#########################################
# GPU EFFECTS
#########################################
#
#  System 0 - gpu drop particle system
#  System 1 - gpu mist particle system
#  System 2 - gpu ground particle system
#
#  Drive Type 0 - driven by the rain variable
#  Drive Type 1 - driven by the snow variable
#  Drive Type 2 - driven by the sandstorm variable
#  Drive Type 9 - driven by no variable
#
#########################################

WEATHER_GPUFX_START

