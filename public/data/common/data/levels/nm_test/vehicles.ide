#																Front	Rear
# cars have two extra fields wheelmodelId and wheel scale
# planes have one extra field model id of low level of detail

barracks,	null,		car,		BARRACKS,	BARRACKS,	LAYOUT_TRUCK,		10,	999,		0.2970,	0.2970,		0.9,		0.0,		1.0,		1.0,		1,		1.5,		-1,	300,		DEFAULT_CAMERA		null			null			noboot+avoidturns+big+delivery+truckfirefx+truckexhaustfx+truckenginefx
